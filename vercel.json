{
    "build": {
        "env": {
            "NODE_ENV": "production"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "staticFiles": {
        "public": true
    },
    "devCommand": "vite dev --port 3000",
    "buildCommand": "vite build",
    "outputDirectory": "dist"
}